# SurrealDB on Railway — environment reference
#
# Copy to `.env` for local reference only. In the one-click template every
# value below is pre-filled: only SURREAL_PASS is generated per deployment.

# Root username for the SurrealDB root user (baked default: root).
SURREAL_USER=root

# Root password. REQUIRED — the entrypoint refuses to boot without it.
# The template generates a random 32-char value automatically.
SURREAL_PASS=change-me-to-a-strong-random-value

# Namespace/database auto-created when the datastore is new (baked defaults).
SURREAL_DEFAULT_NAMESPACE=main
SURREAL_DEFAULT_DATABASE=main

# Log level: none, full, error, warn, info, debug, trace (baked default: info).
SURREAL_LOG=info

# Injected automatically by Railway — the server binds 0.0.0.0:$PORT.
PORT=8080
